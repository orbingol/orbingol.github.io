---
const links = [
  { href: 'https://github.com/orbingol/', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/orbingol/', label: 'LinkedIn' },
  { href: 'https://twitter.com/orbingol', label: 'Twitter' },
  { href: 'https://orcid.org/0000-0002-3139-5725', label: 'ORCID' },
];
---

<ul class="flex flex-wrap items-center gap-x-4 gap-y-2">
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium text-[var(--color-accent)] underline-offset-2 hover:underline"
        >
          {link.label}
        </a>
      </li>
    ))
  }
</ul>
