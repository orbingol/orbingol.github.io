---
type EducationItem = {
  degree: string;
  school: string;
  schoolUrl: string;
  /** ISO 3166-1 alpha-2 country code (e.g. US, TR) */
  countryCode: string;
  note?: string;
  /** Optional; leave empty until ready to show */
  startYear?: string;
  endYear?: string;
};

const education: EducationItem[] = [
  {
    degree: "Ph.D. in Mechanical Engineering",
    school: "Iowa State University",
    schoolUrl: "https://www.iastate.edu",
    countryCode: "US",
    note: "Received Research Excellence Award for outstanding research",
    startYear: "2015",
    endYear: "2019",
  },
  {
    degree: "M.Sc. in Information Systems / Software Management",
    school: "Middle East Technical University",
    schoolUrl: "https://www.metu.edu.tr",
    countryCode: "TR",
    startYear: "",
    endYear: "",
  },
  {
    degree: "M.Sc. in Metallurgical and Materials Engineering",
    school: "Middle East Technical University",
    schoolUrl: "https://www.metu.edu.tr",
    countryCode: "TR",
    startYear: "",
    endYear: "",
  },
  {
    degree: "B.Sc. in Metallurgical and Materials Engineering",
    school: "Middle East Technical University",
    schoolUrl: "https://www.metu.edu.tr",
    countryCode: "TR",
    startYear: "",
    endYear: "",
  },
];

const countryNames: Record<string, string> = {
  US: "United States",
  TR: "Türkiye",
};

function formatYears(item: EducationItem) {
  const start = item.startYear?.trim() ?? "";
  const end = item.endYear?.trim() ?? "";
  if (!start && !end) return null;
  if (start && end) return `${start} – ${end}`;
  return start || end;
}

/** Regional-indicator emoji flag from ISO alpha-2 code */
function flagEmoji(countryCode: string) {
  const code = countryCode.trim().toUpperCase();
  if (!/^[A-Z]{2}$/.test(code)) return "";
  return [...code]
    .map((char) => String.fromCodePoint(0x1f1e6 + char.charCodeAt(0) - 65))
    .join("");
}
---

<div class="relative">
  <ol
    class="relative m-0 list-none border-l-2 border-[var(--color-accent)]/35 pl-0"
  >
    {
      education.map((item) => {
        const years = formatYears(item);
        const flag = flagEmoji(item.countryCode);
        const countryName =
          countryNames[item.countryCode.toUpperCase()] ?? item.countryCode;
        return (
          <li class="relative pb-10 pl-8 last:pb-3">
            <span
              class="absolute top-1.5 -left-[0.4rem] size-3 rounded-full bg-[var(--color-accent)] ring-4 ring-[var(--color-surface)]"
              aria-hidden="true"
            />
            {years && (
              <p class="mb-1 text-sm font-medium tracking-wide text-[var(--color-muted)]">
                {years}
              </p>
            )}
            <h3 class="text-xl font-semibold text-[var(--color-ink)] sm:text-2xl">
              {item.degree}
            </h3>
            <p class="mt-1 flex flex-wrap items-center gap-2 text-lg text-[var(--color-muted)]">
              <a
                href={item.schoolUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-[var(--color-accent)] underline-offset-2 hover:underline"
              >
                {item.school}
              </a>
              {flag && (
                <span
                  class="text-xl leading-none"
                  title={countryName}
                  aria-label={countryName}
                  role="img"
                >
                  {flag}
                </span>
              )}
            </p>
            {item.note && (
              <p class="mt-2 text-base text-[var(--color-ink)]/80 italic">
                {item.note}
              </p>
            )}
          </li>
        );
      })
    }
  </ol>

  {/* End-cap: short stem and horizontal bar */}
  <div
    class="relative h-6 border-l-2 border-[var(--color-accent)]/35"
    aria-hidden="true"
  >
    <span
      class="absolute bottom-0 left-0 h-0.5 w-10 -translate-x-1/2 bg-[var(--color-accent)]/50"
    ></span>
  </div>
</div>
