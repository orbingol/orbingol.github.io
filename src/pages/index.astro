---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Onur Rauf Bingol" description="Personal website of Onur Rauf Bingol.">
	<main class="w-full px-4 py-16 sm:px-6 lg:px-8">
		<p class="text-sm uppercase tracking-[0.2em] text-[var(--color-muted)]">Scaffold</p>
		<h1 class="mt-3 font-[family-name:var(--font-display)] text-4xl text-[var(--color-ink)] sm:text-5xl">
			Onur Rauf Bingol
		</h1>
		<p class="mt-4 max-w-xl text-lg text-[var(--color-muted)]">
			Astro + Tailwind scaffold is ready. Site pages come next.
		</p>
	</main>
</Layout>
