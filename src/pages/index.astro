---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<Layout
	title="Onur Rauf Bingol"
	description="Hello, I am Onur — software, geometric modeling, and personal projects."
>
	<section
		class="animate-fade-up relative z-0 rounded-xl border border-[var(--color-ink)]/10 bg-[var(--color-panel)]/90 p-6 shadow-sm backdrop-blur-sm sm:p-8 lg:p-10"
	>
		<div class="grid w-full gap-x-10 gap-y-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start lg:gap-x-14">
			<div>
				<h1 class="text-5xl font-semibold leading-[1.1] tracking-tight text-[var(--color-ink)] sm:text-6xl lg:text-7xl">
					Hello, I am Onur
				</h1>
				<p class="mt-6 max-w-2xl text-xl leading-relaxed text-[var(--color-muted)] sm:text-2xl">
					I work across software engineering, geometric modeling, and tools that make technical work clearer
					and more practical.
				</p>
			</div>
			<div class="relative z-0 mx-auto w-full max-w-[12rem] lg:mx-0 lg:justify-self-end">
				<img
					src="/placeholders/photo.svg"
					alt="Portrait placeholder for Onur Rauf Bingol"
					class="relative z-0 aspect-[4/5] w-full rounded-md object-cover shadow-sm ring-1 ring-[var(--color-ink)]/10"
					width="320"
					height="400"
				/>
			</div>
		</div>

		<hr class="my-8 border-0 border-t border-[var(--color-ink)]/12 sm:my-10" />

		<div class="grid w-full gap-8 lg:grid-cols-[99fr_1fr] lg:gap-10">
			<p class="text-lg leading-relaxed text-[var(--color-ink)]/85 sm:text-xl">
				I’m especially interested in computer graphics, solid and geometric modeling, finite element and
				isogeometric analysis, composite materials, and robotics — and in building software that connects
				those ideas to real workflows.
			</p>
			<div aria-hidden="true"></div>
		</div>
	</section>

	<section class="mt-16 border-t border-[var(--color-ink)]/10 pt-12 sm:mt-20 sm:pt-16">
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div>
				<h2 class="text-4xl font-semibold tracking-tight text-[var(--color-ink)]">Projects</h2>
				<p class="mt-2 max-w-2xl text-[var(--color-muted)]">
					A few things I’ve built and continue to work on.
				</p>
			</div>
			<a
				href="/projects"
				class="text-sm font-semibold text-[var(--color-accent)] underline-offset-2 hover:underline"
			>
				View all projects
			</a>
		</div>
		<div class="mt-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
			{
				projects.map((project) => (
					<ProjectCard
						title={project.data.title}
						summary={project.data.summary}
						href={`/projects/${project.id}`}
						screenshot={project.data.screenshot}
					/>
				))
			}
		</div>
	</section>
</Layout>
