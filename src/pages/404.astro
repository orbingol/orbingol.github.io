---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | Onur Rauf Bingol" description="The requested page could not be found.">
	<section class="mx-auto w-full max-w-xl py-8 text-center">
		<h1 class="font-[family-name:var(--font-display)] text-4xl text-[var(--color-ink)]">Page not found</h1>
		<p class="mt-4 text-[var(--color-muted)]">
			That URL doesn’t exist on this site.
		</p>
		<p class="mt-6">
			<a href="/" class="font-semibold text-[var(--color-accent)] underline-offset-2 hover:underline">
				Back to home
			</a>
		</p>
	</section>
</Layout>
