---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getEnabledProjects, PROJECT_CATEGORIES, PROJECT_CATEGORY_IDS } from "../../lib/projects";

const projects = await getEnabledProjects();

const categorized = PROJECT_CATEGORY_IDS.map((id) => ({
  id,
  label: PROJECT_CATEGORIES[id],
  projects: projects.filter((project) => project.data.category === id),
})).filter((group) => group.projects.length > 0);

const uncategorized = projects.filter((project) => project.data.category === undefined);
---

<Layout title="Projects" description="Software and research projects by Onur Rauf Bingol, Ph.D." breadcrumbs={[{ label: "Home", href: "/" }, { label: "Projects" }]}>
  <section class="w-full">
    <div class="max-w-3xl">
      <h1 class="text-5xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-6xl">Projects</h1>
      <p class="mt-4 text-lg text-[var(--color-muted)]">Selected work in geometry, digital twins, and AI.</p>
    </div>

    <div class="mt-12 space-y-14">
      {
        categorized.map((group) => (
          <div>
            <h2 class="text-2xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-3xl">{group.label}</h2>
            <hr class="mt-3 border-0 border-t border-[var(--color-ink)]/15" />
            <div class="mt-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
              {group.projects.map((project) => (
                <ProjectCard
                  title={project.data.title}
                  summary={project.data.summary}
                  href={`/projects/${project.id}`}
                  screenshot={project.data.cardImage ?? project.data.screenshot}
                />
              ))}
            </div>
          </div>
        ))
      }

      {
        uncategorized.length > 0 && (
          <div>
            <h2 class="text-2xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-3xl">Various Projects</h2>
            <hr class="mt-3 border-0 border-t border-[var(--color-ink)]/15" />
            <div class="mt-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
              {uncategorized.map((project) => (
                <ProjectCard
                  title={project.data.title}
                  summary={project.data.summary}
                  href={`/projects/${project.id}`}
                  screenshot={project.data.cardImage ?? project.data.screenshot}
                />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
</Layout>
