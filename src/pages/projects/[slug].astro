---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
const links = Object.entries(project.data.links ?? {});
---

<Layout title={`${project.data.title} | Onur Rauf Bingol`} description={project.data.summary}>
	<article class="mx-auto w-full max-w-3xl">
		<p class="text-sm font-semibold uppercase tracking-[0.16em] text-[var(--color-muted)]">
			<a href="/projects" class="hover:text-[var(--color-accent)]">Projects</a>
		</p>
		<h1 class="mt-3 text-5xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-6xl">
			{project.data.title}
		</h1>
		<p class="mt-4 text-lg text-[var(--color-muted)]">{project.data.summary}</p>

		{
			project.data.screenshot && (
				<img
					src={project.data.screenshot}
					alt=""
					class="mt-8 aspect-[16/10] w-full rounded-md object-cover ring-1 ring-[var(--color-ink)]/10"
					loading="lazy"
				/>
			)
		}

		{
			links.length > 0 && (
				<ul class="mt-6 flex flex-wrap gap-x-4 gap-y-2">
					{links.map(([label, href]) => (
						<li>
							<a
								href={href}
								class="text-sm font-medium text-[var(--color-accent)] underline-offset-2 hover:underline"
								target="_blank"
								rel="noopener noreferrer"
							>
								{label}
							</a>
						</li>
					))}
				</ul>
			)
		}

		<div
			class="prose-site mt-8 space-y-4 text-lg leading-relaxed text-[var(--color-ink)]/90 [&_h2]:mt-8 [&_h2]:text-3xl [&_h2]:font-semibold [&_h2]:text-[var(--color-ink)] [&_li]:mt-1 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-5"
		>
			<Content />
		</div>
	</article>
</Layout>
